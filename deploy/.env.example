# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored.

# A strong random password for Postgres. Generate one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# The two DuckDNS names, both pointing at this VM's public IP.
VEHICLE_DOMAIN=cf-dipstick.duckdns.org
ACTIVITY_DOMAIN=cf-dipstick-activity.duckdns.org

# DuckDNS auto-updater: keeps the names pointed at the VM's IP (no reserved IP
# needed). Domains are comma-separated, WITHOUT the .duckdns.org suffix.
DUCKDNS_DOMAINS=cf-dipstick,cf-dipstick-activity
DUCKDNS_TOKEN=

# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Which image tag to run. "latest" tracks main; pin to a sha-<commit> to roll back.
IMAGE_TAG=latest
