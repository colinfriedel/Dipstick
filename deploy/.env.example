# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored.

# A strong random password for Postgres. Generate one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# The two DuckDNS names, both pointing at this VM's public IP.
VEHICLE_DOMAIN=dipstick.duckdns.org
ACTIVITY_DOMAIN=dipstick-activity.duckdns.org

# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Which image tag to run. "latest" tracks main; pin to a sha-<commit> to roll back.
IMAGE_TAG=latest
