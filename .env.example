# Copy to .env for running a service directly on your host (outside Docker),
# e.g. `cd backend/vehicle-service && go run .`
#
# docker-compose.yml sets these itself for the containerized stack, so you only
# need this file for local, non-Docker runs. .env is gitignored.

# Port the HTTP server listens on.
PORT=8080

# Postgres schema this service confines itself to.
DB_SCHEMA=vehicle

# Connection string. Host is "localhost" here because you're connecting from the
# host machine to the port Compose publishes; inside Compose the services use
# "postgres" as the host instead.
DATABASE_URL=postgres://dipstick:dipstick@localhost:5432/dipstick?sslmode=disable
